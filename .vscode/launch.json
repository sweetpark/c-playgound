{
    "version": "0.2.0",
    "inputs": [
        {
            "id": "problem",
            "type": "promptString",
            "description": "문제 번호 (예: P001)",
            "default": "P001"
        }
    ],
    "configurations": [
        {
            "name": "Debug drill (gdb, WSL)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${input:problem}",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build"
        },
        {
            "name": "Debug drill (lldb, macOS)",
            "type": "lldb",
            "request": "launch",
            "program": "${workspaceFolder}/build/${input:problem}",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "build"
        }
    ]
}
