{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "problem",
            "type": "promptString",
            "description": "문제 번호 (예: P001)",
            "default": "P001"
        }
    ],
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "make ${input:problem}",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "check with answer (ANS=1)",
            "type": "shell",
            "command": "make ${input:problem} ANS=1",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make clean",
            "problemMatcher": []
        }
    ]
}
